  "item": [
    {
      "name": "Auth Web Session",
      "item": [
        {
          "name": "Get CSRF Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const match = pm.response.text().match(/name=\"_token\"\\s+value=\"([^\"]+)\"/);",
                  "pm.test('csrf token exists', () => pm.expect(match, 'csrf token').to.not.be.null);",
                  "if (match) pm.collectionVariables.set('csrf_token', match[1]);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "text/html" }
            ],
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "Login as Suporte",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login redirects or succeeds', () => pm.expect([200, 302]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "text/html" },
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token", "value": "{{csrf_token}}", "type": "text" },
                { "key": "email", "value": "{{support_email}}", "type": "text" },
                { "key": "password", "value": "{{password}}", "type": "text" }
              ]
            },
            "url": "{{base_url}}/login"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "text/html" },
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "_token", "value": "{{csrf_token}}", "type": "text" }
              ]
            },
            "url": "{{base_url}}/logout"
          }
        }
      ]
    },
